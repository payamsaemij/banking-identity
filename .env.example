# Identity Service configuration.
# Copy to .env and fill in real values. Never commit a real .env file.

# --- required -------------------------------------------------------------
# PostgreSQL DSN used by the application and by Alembic.
# On the host (outside Docker):   ...@localhost:5432/...  (the published port)
# Inside Docker (docker-compose.yml): the host part is replaced by the
# postgres container's DNS name on the shared network, e.g.
#   postgresql+psycopg://banking:<password>@banking-postgres:5432/banking
# Compose builds that URL itself; keep this one for host-side tooling.
DATABASE_URL=postgresql+psycopg://banking:change-me@localhost:5432/banking

# --- docker compose ---------------------------------------------------------
# Password of the shared PostgreSQL user (banking-infrastructure's
# POSTGRES_PASSWORD). Used only by docker-compose.yml to assemble the
# Docker-internal DATABASE_URL at container start; never baked into the
# image. Must match banking-infrastructure/.env.
POSTGRES_PASSWORD=change-me
# Optional overrides for the compose URL; defaults in docker-compose.yml:
# POSTGRES_USER=banking
# POSTGRES_DB=banking
# POSTGRES_HOST=banking-postgres

# --- core -----------------------------------------------------------------
# local | test | staging | production
ENVIRONMENT=local
LOG_LEVEL=INFO
# json (production default) or console (human-readable, local dev)
LOG_FORMAT=json

# --- token and session lifetimes (seconds) --------------------------------
EMAIL_VERIFICATION_TOKEN_TTL_SECONDS=86400
PASSWORD_RESET_TOKEN_TTL_SECONDS=3600
SESSION_TTL_SECONDS=28800

# --- email delivery -------------------------------------------------------
# console: log the message instead of sending (local/test only)
# smtp: real delivery through the SMTP server below
EMAIL_SENDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@example.com
SMTP_USE_TLS=true
# Base URL used when building links inside emails; the templates below
# point at the (future) frontend pages that complete each flow.
PUBLIC_BASE_URL=http://localhost:8000
EMAIL_VERIFICATION_URL_TEMPLATE={base_url}/verify-email?token={token}
PASSWORD_RESET_URL_TEMPLATE={base_url}/reset-password?token={token}

# --- administrative access --------------------------------------------------
# Service-to-service key guarding POST /api/v1/identity/reactivate.
# Leave empty to disable the endpoint entirely (every caller gets 403).
ADMIN_API_KEY=

# --- rate limits (per client IP, per instance) -------------------------------
REGISTER_RATE_LIMIT_MAX=5
REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
RESEND_RATE_LIMIT_MAX=3
RESEND_RATE_LIMIT_WINDOW_SECONDS=600
PASSWORD_RESET_REQUEST_RATE_LIMIT_MAX=5
PASSWORD_RESET_REQUEST_RATE_LIMIT_WINDOW_SECONDS=600

# --- HTTP -------------------------------------------------------------------
# Comma-separated list of allowed CORS origins, e.g. http://localhost:3000
CORS_ORIGINS=
